# ─── แผนผังพอร์ตบนเครื่องนี้ ─────────────────────────────────────────────────
#   3000 3100 3300 3500            ← ระบบอื่น มีเจ้าของแล้ว
#   3001  km api                   ← ของ km ไม่แตะ
#   8080  phpMyAdmin ของ km        ← ของ km ไม่แตะ
#   3307  MySQL ของ km             ← ของ km ไม่แตะ
#   6380  Redis ของ km             ← ของ km ไม่แตะ
#
#   3800  RCA (แอป)                ← ตัวนี้
#   8089  phpMyAdmin ของ RCA       ← ตัวนี้
#   3308  MySQL ของ RCA            ← ตัวนี้

# ─── ฐานข้อมูลของ RCA ────────────────────────────────────────────────────────
# MySQL ของ RCA เอง สร้างโดย docker compose ไม่เกี่ยวกับ km เลย
# ตอน `docker compose up -d` ครั้งแรก image mysql จะสร้าง database + user
# ตามค่าข้างล่างนี้ให้เอง พร้อม grant สิทธิ์บน database นั้นครบ
# → ไม่ต้องล็อกอิน root ไปรัน CREATE DATABASE / CREATE USER เอง
#
# ⚠️ ไม่ใช่ HOSxP — Phase 1 ไม่เชื่อม HOSxP (สเปกข้อ 4 Non-goals)
#
# ⚠️ ค่าพวกนี้มีผลเฉพาะตอนสร้าง volume ครั้งแรกเท่านั้น
#    แก้ทีหลังต้อง ALTER USER เอง หรือ `docker compose down -v` (ข้อมูลหายหมด)
MYSQL_ROOT_PASSWORD=rcaroot
MYSQL_DATABASE=rca
MYSQL_USER=rca
MYSQL_PASSWORD=rcapass

# DATABASE_URL ประกอบให้อัตโนมัติใน docker-compose.yml จากค่าข้างบน
# (เป็น mysql://rca:...@mysql:3306/rca — ชื่อ service ไม่ใช่ localhost
#  และพอร์ตภายใน 3306 ไม่ใช่ 3308)
#
# บรรทัดนี้ใช้เฉพาะตอนรันนอก docker เช่น `npm run dev` / `npm run db:seed`
DATABASE_URL="mysql://rca:rcapass@localhost:3308/rca"

# ─── ระบบเข้าสู่ระบบ (auth) ──────────────────────────────────────────────────
# ใช้บัญชีเดียวกับระบบ dashboard (ppc-hos-10667) — ตาราง `users` ในฐาน ppchos
# บุคลากรจึงใช้ user/รหัสเดิม ไม่ต้องสร้างบัญชีใหม่ และ role ที่ตั้งไว้แล้วใช้ต่อได้
# ⚠️ RCA ต่อฐานนี้แบบอ่านอย่างเดียว ไม่เขียนอะไรกลับ
AUTH_DB_HOST=
AUTH_DB_PORT=3306
AUTH_DB_USER=
AUTH_DB_PASS=
AUTH_DB_NAME=ppchos

# ต้องยาวอย่างน้อย 32 ตัวอักษร — สร้างด้วย  openssl rand -hex 32
# ⚠️ เปลี่ยนค่านี้ = ทุกคนถูกเตะออกจากระบบ (token เดิมใช้ไม่ได้)
JWT_SECRET=

# ตั้งเป็น true เมื่อเสิร์ฟผ่าน https เท่านั้น
COOKIE_SECURE=false

# ─── AI provider ─────────────────────────────────────────────────────────────
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
# เก็บไว้เฉยๆ Phase 1 ยังไม่ใช้
ANTHROPIC_API_KEY=

# ─── ไฟล์อัปโหลด ─────────────────────────────────────────────────────────────
DOCUMENT_STORAGE_DIR=./data/documents
MAX_UPLOAD_BYTES=10485760

# ─── พอร์ตที่เปิดออกมาบน host ────────────────────────────────────────────────
APP_PORT=3800
PHPMYADMIN_PORT=8089
DB_PUBLISH_PORT=3308
PMA_UPLOAD_LIMIT=64M

# รันนอก docker (`npm run dev`) Next.js จะเกาะ 3000 ซึ่งมีเจ้าของแล้ว
# ตั้ง PORT ให้ตรงกับที่ใช้จริง — Next.js อ่านตัวแปรนี้เอง
PORT=3800
