# ─── แผนผังพอร์ตบนเครื่องนี้ ─────────────────────────────────────────────────
#   8080  km-system (แอป)          ← ของเดิม
#   8088  RCA (แอป)                ← ตัวนี้
#   8089  phpMyAdmin               ← ตัวนี้
#   3306  MySQL ตัวอื่น            ← ของเดิม
#   3307  MySQL ของ km             ← ของเดิม (RCA ใช้ตัวนี้ร่วม)
#   3308  ว่าง                      ← ไม่ได้ใช้

# ─── ฐานข้อมูล ───────────────────────────────────────────────────────────────
# ใช้ MySQL "ตัวเดียวกับ km-system" ตามสเปกข้อ 3 แต่แยก database
#   km  → database ของ km
#   RCA → database ชื่อ rca (สร้างใหม่ผ่าน phpMyAdmin)
#
# ⚠️ ไม่ใช่ HOSxP — Phase 1 ไม่เชื่อม HOSxP (สเปกข้อ 4 Non-goals)
#
# host = "ชื่อ service MySQL ของ km" (คนละ container กัน localhost ใช้ไม่ได้)
# port = 3306 คือพอร์ต "ภายใน" ของ container ไม่ใช่ 3307 ที่ km เปิดออกมาบน host
DATABASE_URL="mysql://rca:changeme@mysql:3306/rca"

# ─── การต่อเข้า stack ของ km ─────────────────────────────────────────────────
# หาชื่อ network:  docker network ls
# หาชื่อ service:  docker compose -f <path ของ km>/docker-compose.yml ps
KM_NETWORK=km-system_default
DB_HOST=mysql
DB_PORT=3306

# ─── AI provider ─────────────────────────────────────────────────────────────
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
# เก็บไว้เฉยๆ Phase 1 ยังไม่ใช้
ANTHROPIC_API_KEY=

# ─── ไฟล์อัปโหลด ─────────────────────────────────────────────────────────────
DOCUMENT_STORAGE_DIR=./data/documents
MAX_UPLOAD_BYTES=10485760

# ─── พอร์ตที่เปิดออกมาบน host (ใช้เฉพาะตอนรันด้วย docker compose) ────────────
APP_PORT=8088
PHPMYADMIN_PORT=8089
PMA_UPLOAD_LIMIT=64M
