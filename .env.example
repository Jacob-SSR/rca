# ─── แผนผังพอร์ตบนเครื่องนี้ ─────────────────────────────────────────────────
#   3001  km api (NestJS)          ← ของ km
#   8080  phpMyAdmin ของ km        ← ของ km — ใช้จัดการ DB ของ RCA ได้เลย
#   3307  MySQL ของ km             ← ของ km (RCA ใช้ตัวนี้ร่วม)
#   6380  Redis ของ km             ← ของ km
#   8088  RCA (แอป)                ← ตัวนี้
#   8089  phpMyAdmin ของ RCA       ← ตัวนี้
#   3308  ว่าง                      ← ไม่ได้ใช้

# ─── ฐานข้อมูล ───────────────────────────────────────────────────────────────
# ใช้ MySQL "ตัวเดียวกับ km-system" ตามสเปกข้อ 3 แต่แยก database และแยก user
#   km  → database km_ppch, user km
#   RCA → database rca,     user rca
#
# ⚠️ สร้าง database/user ต้องล็อกอิน phpMyAdmin (:8080) เป็น root
#    user km มีสิทธิ์เฉพาะ km_ppch จะได้ #1044 Access denied — ดูขั้นตอนใน README
#
# ⚠️ ไม่ใช่ HOSxP — Phase 1 ไม่เชื่อม HOSxP (สเปกข้อ 4 Non-goals)
#
# host = "mysql" คือชื่อ service MySQL ใน compose ของ km (คนละ container กัน
#        localhost ใช้ไม่ได้)
# port = 3306 คือพอร์ต "ภายใน" ของ container ไม่ใช่ 3307 ที่ km เปิดออกมาบน host
DATABASE_URL="mysql://rca:changeme@mysql:3306/rca"

# ─── การต่อเข้า stack ของ km ─────────────────────────────────────────────────
# compose ของ km ไม่ได้ประกาศ networks จึงเป็น "<ชื่อโฟลเดอร์ที่รัน km>_default"
# ยืนยันชื่อจริง:  docker network ls
KM_NETWORK=kmppc-backtend_default

# ─── AI provider ─────────────────────────────────────────────────────────────
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
# เก็บไว้เฉยๆ Phase 1 ยังไม่ใช้
ANTHROPIC_API_KEY=

# ─── ไฟล์อัปโหลด ─────────────────────────────────────────────────────────────
DOCUMENT_STORAGE_DIR=./data/documents
MAX_UPLOAD_BYTES=10485760

# ─── พอร์ตที่เปิดออกมาบน host (ใช้เฉพาะตอนรันด้วย docker compose) ────────────
APP_PORT=8088
PHPMYADMIN_PORT=8089

# ─── phpMyAdmin ของ RCA ──────────────────────────────────────────────────────
# ชี้ไป MySQL ตัวเดียวกับ km (ชื่อ service = mysql, พอร์ตภายใน = 3306)
DB_HOST=mysql
DB_PORT=3306
PMA_UPLOAD_LIMIT=64M
