# ─── ฐานข้อมูล ───────────────────────────────────────────────────────────────
# ใช้ MySQL "ตัวเดียวกับ km-system" ตามสเปกข้อ 3 แต่แยก database
#   km  → database ของ km
#   RCA → database ชื่อ rca (สร้างใหม่ผ่าน phpMyAdmin)
#
# ⚠️ ไม่ใช่ HOSxP — Phase 1 ไม่เชื่อม HOSxP (สเปกข้อ 4 Non-goals)
#
# host ต้องเป็น "ชื่อ service MySQL ของ km" เพราะรันอยู่คนละ container
# (localhost ใน container = ตัว container เอง ไม่ใช่ MySQL)
DATABASE_URL="mysql://rca:changeme@mysql:3306/rca"

# ─── การต่อเข้า stack ของ km ─────────────────────────────────────────────────
# หาชื่อ network:  docker network ls
# หาชื่อ service:  docker compose -f <path ของ km>/docker-compose.yml ps
KM_NETWORK=km-system_default
DB_HOST=mysql
DB_PORT=3306

# ─── AI provider ─────────────────────────────────────────────────────────────
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
# เก็บไว้เฉยๆ Phase 1 ยังไม่ใช้
ANTHROPIC_API_KEY=

# ─── ไฟล์อัปโหลด ─────────────────────────────────────────────────────────────
DOCUMENT_STORAGE_DIR=./data/documents
MAX_UPLOAD_BYTES=10485760

# ─── พอร์ต (ใช้เฉพาะตอนรันด้วย docker compose) ───────────────────────────────
APP_PORT=3000
PHPMYADMIN_PORT=8088
PMA_UPLOAD_LIMIT=64M
