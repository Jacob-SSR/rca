// prisma/schema.prisma
// ตาม MVP Phase 1 Spec ข้อ 5 — ห้ามเพิ่ม/ลด field โดยไม่แก้สเปกก่อน

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model CriteriaSet {
  id         String  @id @default(cuid())
  code       String  @unique // e.g. "A1_OPD_2015"
  name       String
  version    Int
  source     String? @db.Text
  sourcePage String?
  maxScore   Int
  isActive   Boolean @default(true)

  criteria Criterion[]
  reviews  Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Criterion {
  id            String @id @default(cuid())
  criteriaSetId String

  code     String // e.g. "CC", "DIAGNOSIS"
  name     String  @db.Text
  maxScore Int
  allowNA  Boolean @default(false)
  naRule   String? @db.Text

  criteriaSet CriteriaSet @relation(fields: [criteriaSetId], references: [id])

  levels      CriterionLevel[]
  reviewItems ReviewItem[]

  @@unique([criteriaSetId, code])
}

model CriterionLevel {
  id          String @id @default(cuid())
  criterionId String

  score       Int
  description String @db.Text

  criterion Criterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([criterionId, score])
}

model Case {
  id String @id @default(cuid())

  caseNumber String  @unique
  title      String?
  status     String  @default("DRAFT")

  // Phase 2 — อ้างอิงกลับไป HOSxP
  // ⚠️ hosxpPatientRef คือ HN = PHI ห้ามส่งเข้า AI
  hosxpPatientRef String? @db.VarChar(20)
  hosxpVisitRef   String? @db.VarChar(20)

  /// ใครเป็นคนสร้างเคสนี้ — username จากตาราง users ของ ppc-hos-10667
  /// ใช้ตัดสินสิทธิ์แก้/ลบ: เจ้าของเท่านั้น (หรือคนที่มีสิทธิ์ manage)
  createdBy String? @db.VarChar(100)
  /// ชื่อที่แสดง — เก็บซ้ำไว้เพื่อไม่ต้อง join ข้ามเซิร์ฟเวอร์ทุกครั้งที่แสดงรายการ
  createdByName String? @db.VarChar(200)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events    TimelineEvent[]
  documents Document[]
  reviews   Review[]
  forms     RecordForm[]

  @@index([hosxpPatientRef])
  @@index([hosxpVisitRef])
  @@index([createdBy])
}

/// ฟอร์มบันทึกเวชระเบียน — ตัวที่ CRUD และ generate DOCX ออกมา (Phase 2)
///
/// ช่องทั้งหมดตรงกับเกณฑ์ A1 หกข้อ กรอกครบ = มีข้อมูลพอให้ได้ 17 คะแนน
/// ⚠️ ฟอร์มคือแหล่งความจริงที่แก้ได้ DOCX คือผลลัพธ์ที่ generate ออกมา
///    แก้ฟอร์ม → generate ใหม่ → Document.version +1 ไม่แก้ DOCX ตรงๆ
model RecordForm {
  id     String @id @default(cuid())
  caseId String

  // ── ข้อมูลผู้ป่วย ──────────────────────────────────────────────────────────
  // ⚠️ hn / patientName เป็น PHI — ถูก mask ก่อนเข้า AI เสมอ
  hn          String? @db.VarChar(20)
  patientName String? @db.VarChar(200)
  age         String? @db.VarChar(50)
  gender      String? @db.VarChar(20)
  department  String? @db.VarChar(100)
  pttype      String? @db.VarChar(100)

  // ── SERVICE_DATETIME ───────────────────────────────────────────────────────
  serviceDate String? @db.VarChar(50)
  serviceTime String? @db.VarChar(20)

  // ── CC ─────────────────────────────────────────────────────────────────────
  chiefComplaint String? @db.Text

  // ── HISTORY ────────────────────────────────────────────────────────────────
  presentIllness  String? @db.Text
  pastHistory     String? @db.Text
  personalHistory String? @db.Text

  // ── PHYSICAL_EXAM ──────────────────────────────────────────────────────────
  vitalSigns   String? @db.Text
  physicalExam String? @db.Text
  labResult    String? @db.Text

  // ── DIAGNOSIS / TREATMENT ──────────────────────────────────────────────────
  diagnosis String? @db.Text
  treatment String? @db.Text

  note     String? @db.Text
  recorder String? @db.VarChar(200)

  // ── ที่มาของข้อมูล ─────────────────────────────────────────────────────────
  source        String    @default("manual") // "manual" | "hosxp"
  hosxpVisitRef String?   @db.VarChar(20)
  prefilledAt   DateTime?

  createdBy String? @db.VarChar(100)
  updatedBy String? @db.VarChar(100)

  case      Case       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  documents Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caseId])
  @@index([hn])
}

// หมายเหตุ: ไม่ใส่ HN/VN ใน Phase 1 (ยังไม่เชื่อม HOSxP)
// Phase 2 ค่อยเพิ่ม hosxpPatientRef / hosxpVisitRef

model TimelineEvent {
  id     String @id @default(cuid())
  caseId String

  eventTime DateTime?
  title     String    @db.Text
  source    String // "document" | "manual" | "ai"

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([caseId, eventTime])
}

// ห้ามเพิ่ม confidence / severity / anomaly field ใน Phase 1

model Document {
  id     String @id @default(cuid())
  caseId String

  fileName String
  filePath String // path บน volume, ไม่เก็บไฟล์ใน DB
  mimeType String
  fileSize Int

  /// ใครเป็นคนอัปไฟล์นี้ — ใช้ตัดสินสิทธิ์ลบ/แทนที่ไฟล์
  createdBy     String? @db.VarChar(100)
  createdByName String? @db.VarChar(200)

  /// ข้อความที่สกัดได้ — ว่าง = ชนิดไฟล์นี้อ่านข้อความอัตโนมัติไม่ได้
  /// (เก็บไฟล์ไว้ได้ แต่ส่งให้ AI ตรวจไม่ได้ ต้องแปลงเป็น .docx/.pdf ก่อน)
  extractedText String? @db.LongText

  version Int @default(1)

  // DOCX ที่ generate จากฟอร์มจะผูกกลับไปที่ฟอร์มต้นทาง
  // null = ไฟล์ที่ผู้ใช้อัปโหลดเอง (Phase 1)
  recordFormId String?

  case       Case        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  recordForm RecordForm? @relation(fields: [recordFormId], references: [id])
  reviews    Review[]

  createdAt DateTime @default(now())

  @@index([caseId])
  @@index([recordFormId])
}

model Review {
  id String @id @default(cuid())

  caseId        String
  documentId    String
  criteriaSetId String

  provider String // "gemini" | "anthropic" (Phase 1: gemini เท่านั้น)
  model    String?

  status String @default("PENDING")

  // "upload" = อัปโหลด DOCX เอง | "form" = generate จาก RecordForm
  sourceType String @default("upload")

  totalScore Int?
  maxScore   Int?
  percentage Decimal? @db.Decimal(5, 2)

  factsJson Json? // ผลลัพธ์ extractFacts() จาก AI ทั้งก้อน

  case        Case        @relation(fields: [caseId], references: [id])
  document    Document    @relation(fields: [documentId], references: [id])
  criteriaSet CriteriaSet @relation(fields: [criteriaSetId], references: [id])

  items ReviewItem[]

  createdAt DateTime @default(now())

  @@index([caseId])
  @@index([documentId])
  @@index([criteriaSetId])
}

model ReviewItem {
  id String @id @default(cuid())

  reviewId    String
  criterionId String

  score Int?
  isNA  Boolean @default(false)

  reason   String? @db.Text // ทำไมได้คะแนนนี้ (มาจาก Rule Engine)
  evidence String? @db.Text // ข้อความจริงจากเอกสารที่ใช้ตัดสิน

  review    Review    @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  criterion Criterion @relation(fields: [criterionId], references: [id])

  @@unique([reviewId, criterionId])
  @@index([criterionId])
}

/// แผ่นงานของแบบฟอร์มตรวจสอบคุณภาพในภาคผนวก ข ของคู่มือ สนย. (A1-A4, B1-B3, C1)
///
/// ⚠️ เก็บแถวเป็น JSON ก้อนเดียว ไม่แยกตาราง เพราะหนึ่งแผ่น = หนึ่งเอกสาร
///    คนกรอกแก้ทั้งแผ่นแล้วเซฟทีเดียวเหมือนกรอกกระดาษ ไม่มีการ query รายแถว
///    แยกตารางจะได้แค่ปัญหาเรื่องลำดับแถวกับ id ที่เปลี่ยนทุกครั้งที่เซฟ
///
/// โครงของแต่ละฟอร์มอยู่ใน lib/audit-forms/registry.ts ไม่ได้อยู่ใน schema
/// เพราะคอลัมน์ของฟอร์มราชการเปลี่ยนตามคู่มือ ไม่ควรต้อง migrate ฐานทุกครั้ง
model AuditSheet {
  id String @id @default(cuid())

  /// A1 | A2 | A3 | A4 | B1 | B2 | B3 | C1
  formCode String @db.VarChar(10)

  /// ชื่อที่ผู้ใช้ตั้งเองไว้หาแผ่นเจอ เช่น "ตรวจ OPD ไตรมาส 3/2569"
  title String? @db.VarChar(200)

  /// ค่าหัวฟอร์ม (รหัสสถานพยาบาล/จังหวัด/ช่วงวันที่/ผู้ตรวจ) ตาม meta ของฟอร์มนั้น
  meta Json

  /// แถวในตาราง — array ของ object ที่ key ตรงกับ column.key
  rows Json

  createdBy String? @db.VarChar(100)
  updatedBy String? @db.VarChar(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([formCode])
  @@index([createdAt])
}
